# Copy this file to .env and fill in your values. Never commit .env.

# --- Chat model for the agents ---
# "openai" runs the agents on GPT Luna (needs OPEN_AI_KEY); "ollama" uses the local OLLAMA_MODEL.
LLM_PROVIDER=ollama
OPEN_AI_KEY=sk-your-openai-key
# gpt-6-luna or gpt-5.6-luna (GPT Luna only supports the default temperature)
OPENAI_MODEL=gpt-6-luna

# --- Azure DevOps ---
# Live mode (REST API 7.1) is used when ADO_ORG_URL, ADO_PROJECT and ADO_PAT are all set;
# otherwise the notebooks write to the local ado_dry_run_board.json.
ADO_ORG_URL=https://dev.azure.com/<your-organization>
ADO_PROJECT=<your-project>
ADO_PAT=<your-personal-access-token>
# "User Story" for Agile, "Product Backlog Item" for Scrum
ADO_STORY_TYPE=User Story
# Support tickets: due date field on tasks (empty = not set) and working hours per day for the schedule
ADO_DUE_DATE_FIELD=Custom.DueDate1
ADO_HOURS_PER_DAY=6

# --- LangSmith tracing (optional; leave empty to run without tracing) ---
LANGSMITH_API_KEY=

# --- Ollama (local models; the embeddings always run here) ---
OLLAMA_MODEL=gemma4:e4b
EMBED_MODEL=nomic-embed-text

# --- Outlook through Microsoft Graph (notebook 03; empty = local dry-run mailbox) ---
# Entra ID > App registrations: "Allow public client flows" = Yes, delegated Mail.ReadWrite + Mail.Send.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
# App-only alternative for a shared support mailbox (admin consent, application permissions):
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=support@your-company.com
GRAPH_MAIL_FOLDER=inbox

# --- Support email filter: what the assistant may read ---
EMAIL_REQUIRED_KEYWORDS=f&o,support
EMAIL_INTERNAL_DOMAINS=your-company.com
EMAIL_INCLUDE_INTERNAL=false
# Comma-separated sender names (your team) and keywords/domains to skip
TECHNICAL_PEOPLE=
FUNCTIONAL_PEOPLE=
EXCLUDE_EMAILS=
DISINCLUDE_DOMAINS=

# --- Change Request form (ERP Change/Additional Request Form) ---
CR_PROJECT_NAME=Dynamics 365 F&O
# "Required Phase of Project" for change requests from the delivery workflow and from support emails
CR_PROJECT_PHASE=Phase I
CR_SUPPORT_PHASE=Support

# --- SharePoint document filing: <root>/<Customer>/<ID - Description>/<Document type>/<file> ---
# Uses the Graph app above: delegated Sites.ReadWrite.All, or app-only (GRAPH_CLIENT_SECRET) with Sites.Selected.
# Live only when GRAPH_CLIENT_ID/GRAPH_TENANT_ID are set too; otherwise files go to sharepoint_dry_run/.
SHAREPOINT_SITE_URL=https://your-company.sharepoint.com/sites/YourSite
# Library name as shown in SharePoint ("Documents" is the default library, "Shared Documents" in URLs)
SHAREPOINT_LIBRARY=Documents
SHAREPOINT_ROOT_FOLDER=Support
